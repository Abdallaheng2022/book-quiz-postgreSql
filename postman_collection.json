{
  "info": {
    "name": "Book Quiz API - Session 4",
    "description": "Import into Postman. Run 'Create book' first: it saves the new id into {{bookId}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. List books (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create book (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"bookId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Atomic Habits\",\n  \"author\": \"James Clear\",\n  \"genre\": \"Self-help\"\n}"
        }
      }
    },
    {
      "name": "3. Get book by id (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update book (200)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books/{{bookId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"available\": false\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Delete book (204)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERR - Get deleted book (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERR - Create with invalid data (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"author\": 5\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERR - Empty PATCH (400)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books/{{bookId}}",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERR - Broken JSON (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{ \"title\": "
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERR - Unknown route (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/unknown"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "ERR - Body sent as Text, not JSON (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"a\",\"author\":\"b\",\"genre\":\"c\"}"
        }
      }
    },
    {
      "name": "ERR - Unknown field id on POST (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"my-id\",\n  \"title\": \"a\",\n  \"author\": \"b\",\n  \"genre\": \"c\"\n}"
        }
      }
    },
    {
      "name": "ERR - Update missing book (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books/does-not-exist",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"x\"\n}"
        }
      }
    },
    {
      "name": "ERR - Delete missing book (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Error has the standard shape\", () => pm.expect(pm.response.json().error.message).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/books/does-not-exist"
      }
    }
  ]
}
