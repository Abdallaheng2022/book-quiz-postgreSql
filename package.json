{
  "name": "book-quiz-api",
  "version": "1.0.0",
  "description": "Library Book Management API (Express 5 + TypeScript + Zod) - first step toward an AI book-quiz platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
